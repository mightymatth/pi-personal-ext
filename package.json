{
	"name": "pi-personal-ext",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/mightymatth/pi-personal-ext.git"
	},
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"skills": [
			"./skills"
		],
		"prompts": [
			"./prompts"
		]
	},
	"scripts": {
		"setup": "bun run setup.ts",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"fix": "biome check --write .",
		"typecheck": "bun tsc --noEmit",
		"check": "biome check . && bun tsc --noEmit",
		"check:fix": "biome check --write . && bun tsc --noEmit",
		"lint:fix": "bun run check:fix",
		"test": "bun test",
		"skills": "bun run skills.ts"
	},
	"dependencies": {
		"commander": "^15.0.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^1.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@types/bun": "^1.3.14",
		"typescript": "^6.0.3"
	}
}
