{
	"name": "pi-personal-ext",
	"version": "1.0.0",
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"fix": "biome check --write .",
		"typecheck": "bun tsc --noEmit",
		"check": "biome check . && bun tsc --noEmit",
		"check:fix": "biome check --write . && bun tsc --noEmit",
		"lint:fix": "bun run check:fix",
		"test": "bun test",
		"skills": "bun run skills.ts"
	},
	"dependencies": {
		"@typesafe-ai/sdk": "^0.6.0",
		"commander": "^14.0.3",
		"pi-permission-system": "*",
		"playwright": "^1.59.0",
		"yaml": "^2.8.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@types/bun": "^1.3.14",
		"typescript": "^6.0.3",
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@earendil-works/pi-ai": "^0.87.1",
		"@earendil-works/pi-tui": "^0.87.1"
	}
}
