{
	"name": "pi-personal-ext",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/mightymatth/pi-personal-ext.git"
	},
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"skills": [
			"./skills"
		],
		"prompts": [
			"./prompts"
		]
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"setup": "bun run setup.ts",
		"fmt": "bun fmt",
		"format": "bun fmt",
		"lint": "bun lint",
		"fix": "bun lint --fix && bun fmt",
		"typecheck": "bun check",
		"check": "bun check",
		"check:fix": "bun run fix && bun run verify",
		"lint:fix": "bun lint --fix",
		"verify": "bun fmt --check && bun lint --max-warnings=0 && bun check && bun test",
		"test": "bun test",
		"skills": "bun run skills.ts"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"marked": "18.0.11"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^1.0.3"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14"
	}
}
