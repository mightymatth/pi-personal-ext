{
	"name": "copy-file-reference",
	"publisher": "local",
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"vscode": "^1.80.0"
	},
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "copyFileReference.copy",
				"title": "Copy File Reference"
			},
			{
				"command": "copyFileReference.copyWithSelection",
				"title": "Copy File Reference with Selection"
			}
		],
		"keybindings": [
			{
				"command": "copyFileReference.copy",
				"key": "ctrl+alt+c",
				"mac": "ctrl+alt+c",
				"when": "editorTextFocus"
			},
			{
				"command": "copyFileReference.copyWithSelection",
				"key": "ctrl+alt+shift+c",
				"mac": "ctrl+alt+shift+c",
				"when": "editorTextFocus"
			}
		]
	}
}
